{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SMOT Smart Archive - Default permissions for main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-set-title",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "updater:default",
    "core:path:default"
  ]
}
