{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SMOT Smart Archive - Default permissions for main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-set-title",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "updater:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-app-meta",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "http://localhost:11434/*" }]
    },
    "path:default"
  ]
}
